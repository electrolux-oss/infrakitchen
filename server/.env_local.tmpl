# RabbitMQ
BROKER_URL = "amqp://guest:guest@localhost:5672"

# Externally-visible base URL of InfraKitchen (e.g. https://infrakitchen.example.com).
# Required for GCP Workload Identity Federation via OIDC (used as the OIDC issuer) and notification service.
INFRAKITCHEN_URL = ""

# API Token expiration time and secret
SESSION_EXPIRATION = "3600" # 1 hour
JWT_KEY = "CHANGE_ME"

# generate a random key by command `uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
ENCRYPTION_KEY = "CHANGE_ME"

# Other
CACHE_DISABLED = "false"
LOG_LEVEL = "DEBUG"

DEMO_MODE = "true"

# OpenTelemetry metrics
OTEL_METRICS_ENABLED = "true"
OTEL_SERVICE_NAME = "infrakitchen"
OTEL_EXPORTER_OTLP_ENDPOINT = "http://localhost:4318/v1/metrics"
OTEL_EXPORTER_OTLP_PROTOCOL = "http/protobuf"
OTEL_RESOURCE_ATTRIBUTES = ""
