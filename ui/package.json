{
  "name": "infra-kitchen",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24 || 26"
  },
  "scripts": {
    "dev": "vite",
    "build": "yarn workspace @electrolux-oss/infrakitchen build && vite build",
    "serve": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint --fix ./app",
    "lint-lib": "eslint --fix ./frontend-lib/src",
    "format:check": "prettier --check ./app",
    "format": "prettier --write ./app",
    "format-lib": "prettier --write ./frontend-lib/src",
    "format-lib:check": "prettier --check ./frontend-lib/src"
  },
  "workspaces": [
    "frontend-lib"
  ],
  "dependencies": {
    "@electrolux-oss/infrakitchen": "workspace:^",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@iconify-icons/ic": "^2.0.0",
    "@iconify-icons/logos": "^2.0.3",
    "@iconify-icons/octicon": "^2.0.8",
    "@iconify/react": "^6.0.2",
    "@xyflow/react": "^12.12.0",
    "jwt-decode": "^4.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitejs/plugin-react": "^6.1.1",
    "daisyui": "5.7.47",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^16.5.0",
    "prettier": "~3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-dts": "^5.1.1",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "resolutions": {
    "globals": "^16.0.0",
    "typescript": "5.9.3",
    "react": "^19.3.0",
    "react-router": "7.18.2",
    "linkify-it": "^5.0.2"
  },
  "packageManager": "yarn@4.4.1"
}
