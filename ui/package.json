{
  "name": "infra-kitchen",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24 || 26"
  },
  "scripts": {
    "dev": "vite",
    "build": "yarn workspace @electrolux-oss/infrakitchen build && vite build",
    "serve": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint --fix --ext .js,.jsx,.ts,.tsx ./app",
    "lint-lib": "eslint --fix --ext .js,.jsx,.ts,.tsx ./frontend-lib/src",
    "format:check": "prettier --check ./app",
    "format": "prettier --write ./app",
    "format-lib": "prettier --write ./frontend-lib/src",
    "format-lib:check": "prettier --check ./frontend-lib/src"
  },
  "workspaces": [
    "frontend-lib"
  ],
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@electrolux-oss/infrakitchen": "workspace:^",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@iconify/react": "^6.0.2",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/x-tree-view": "^9.14.0",
    "@uiw/react-codemirror": "^4.25.12",
    "@xyflow/react": "^12.12.0",
    "ansi-to-react": "^6.2.6",
    "codemirror-lang-hcl": "^0.2.0",
    "date-fns": "^4.4.0",
    "graphql": "^17.0.2",
    "graphql-ws": "^6.3.0",
    "jwt-decode": "^4.0.0",
    "material-ui-popup-state": "5.3.7",
    "react": "^19.3.0",
    "react-diff-viewer-continued": "^4.4.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "react-router": "^8.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "^8.4.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^16.5.0",
    "prettier": "~3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-dts": "^5.1.1",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "resolutions": {
    "globals": "^16.0.0",
    "typescript": "5.9.3",
    "react": "^19.3.0",
    "react-router": "7.18.2",
    "linkify-it": "^5.0.2"
  },
  "packageManager": "yarn@4.4.1"
}
